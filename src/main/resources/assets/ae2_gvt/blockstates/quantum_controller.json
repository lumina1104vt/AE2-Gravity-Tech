{
  "multipart": [
    {
      "when": {
        "type": "block",
        "state": "offline"
      },
      "apply": {
        "model": "ae2_gvt:block/quantum_controller/block_offline"
      }
    },
    {
      "when": {
        "type": "block",
        "state": "online"
      },
      "apply": {
        "model": "ae2_gvt:block/quantum_controller/block_online"
      }
    },
    {
      "when": {
        "type": "block",
        "state": "conflicted"
      },
      "apply": {
        "model": "ae2_gvt:block/quantum_controller/block_conflicted"
      }
    },
    {
      "when": {
        "type": "column_x",
        "state": "offline"
      },
      "apply": {
        "model": "ae2_gvt:block/quantum_controller/column_x_offline"
      }
    },
    {
      "when": {
        "type": "column_y",
        "state": "offline"
      },
      "apply": {
        "model": "ae2_gvt:block/quantum_controller/column_offline"
      }
    },
    {
      "when": {
        "type": "column_z",
        "state": "offline"
      },
      "apply": {
        "model": "ae2_gvt:block/quantum_controller/column_z_offline"
      }
    },
    {
      "when": {
        "type": "column_x",
        "state": "online"
      },
      "apply": {
        "model": "ae2_gvt:block/quantum_controller/column_x_online"
      }
    },
    {
      "when": {
        "type": "column_y",
        "state": "online"
      },
      "apply": {
        "model": "ae2_gvt:block/quantum_controller/column_online"
      }
    },
    {
      "when": {
        "type": "column_z",
        "state": "online"
      },
      "apply": {
        "model": "ae2_gvt:block/quantum_controller/column_z_online"
      }
    },
    {
      "when": {
        "type": "column_x",
        "state": "conflicted"
      },
      "apply": {
        "model": "ae2_gvt:block/quantum_controller/column_x_conflicted"
      }
    },
    {
      "when": {
        "type": "column_y",
        "state": "conflicted"
      },
      "apply": {
        "model": "ae2_gvt:block/quantum_controller/column_conflicted"
      }
    },
    {
      "when": {
        "type": "column_z",
        "state": "conflicted"
      },
      "apply": {
        "model": "ae2_gvt:block/quantum_controller/column_z_conflicted"
      }
    },
    {
      "when": {
        "type": "inside_a",
        "state": "offline|online"
      },
      "apply": {
        "model": "ae2_gvt:block/quantum_controller/inside_a"
      }
    },
    {
      "when": {
        "type": "inside_a",
        "state": "conflicted"
      },
      "apply": {
        "model": "ae2_gvt:block/quantum_controller/inside_a_conflicted"
      }
    },
    {
      "when": {
        "type": "inside_b",
        "state": "offline|online"
      },
      "apply": {
        "model": "ae2_gvt:block/quantum_controller/inside_b"
      }
    },
    {
      "when": {
        "type": "inside_b",
        "state": "conflicted"
      },
      "apply": {
        "model": "ae2_gvt:block/quantum_controller/inside_b_conflicted"
      }
    }
  ]
}
